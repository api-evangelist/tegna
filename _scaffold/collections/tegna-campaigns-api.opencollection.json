{
  "opencollection": "1.0.0",
  "info": {
    "name": "TEGNA AudienceOne Audiences Campaigns API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Campaigns",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Campaigns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tegna.com/v1/campaigns",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter campaigns by status."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve advertising campaigns for the authenticated advertiser."
        },
        {
          "info": {
            "name": "Create Campaign",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tegna.com/v1/campaigns",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new digital advertising campaign."
        },
        {
          "info": {
            "name": "Get Campaign",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tegna.com/v1/campaigns/:campaignId",
            "params": [
              {
                "name": "campaignId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve details for a specific advertising campaign."
        },
        {
          "info": {
            "name": "Update Campaign",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.tegna.com/v1/campaigns/:campaignId",
            "params": [
              {
                "name": "campaignId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing advertising campaign."
        }
      ]
    }
  ],
  "bundled": true
}